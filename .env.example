# ---------------------------------------------------------------------------
# Curiosity Daily — environment variables
# Copy this file to `.env` and fill in your own values.
# All secrets are read from the environment ONLY — nothing is ever hardcoded.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (M0 free tier is fine).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Name of the database to use inside the cluster.
MONGODB_DB=curiosity

# Jina AI API key for embeddings (https://jina.ai/embeddings — free tier available).
JINA_API_KEY=

# Which LLM provider to use for the agent step: "gemini" or "groq".
LLM_PROVIDER=gemini

# Provide the key matching the provider you selected above.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override default model names.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: contact string placed inside the Wikimedia User-Agent header.
# The Wikimedia API REQUIRES a descriptive User-Agent with a contact.
CURIOSITY_CONTACT=curiosity-daily (https://github.com/your-user/curiosity-daily)

# Tavily web search API key (https://tavily.com — free dev tier).
TAVILY_API_KEY=

# Public base URL of the deployed backend API (leave blank for local use).
# The static site's search bar calls this. Example: https://your-app.onrender.com
CURIOSITY_API_BASE=
